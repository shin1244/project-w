; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Burn Quarter"
run/main_scene="res://lobby/Lobby.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

Settings="*res://settings/Settings.cs"
Net="*res://network/NetClient.cs"
MatchSession="*res://network/MatchSession.cs"
OrderSound="*res://audio/OrderSound.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Project W"

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po")
locale/fallback="ko"

[physics]

3d/physics_engine="Jolt Physics"

[gui]

timers/tooltip_delay_sec=0.0

[rendering]

rendering_device/driver.windows="d3d12"
