<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ProjectW</RootNamespace>
  </PropertyGroup>
  <!-- Exported builds ship the game only: checks, editor tools and preview scenes stay out of the
       assembly, as export_presets.cfg keeps their scenes out of the pack (docs/friend-test.md). -->
  <ItemGroup Condition=" '$(Configuration)' == 'ExportRelease' Or '$(Configuration)' == 'ExportDebug' ">
    <Compile Remove="tests/**;tools/**;previews/**" />
  </ItemGroup>
</Project>